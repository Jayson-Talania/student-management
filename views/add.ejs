<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link rel="stylesheet" href="/style.css" type="text/css">
</head>

<body>

    <header>
        <h1>Student Management System</h1>
        <nav>
            <a href="/">Back to Directory</a>
        </nav>
    </header>

    <div class="container">
        <h2>Add New Student</h2>

        <form action="/students/add" method="POST" style="display: flex; flex-direction: column; gap: 1rem; max-width: 500px;">
            <div>
                <label>Student ID:</label><br>
                <input type="text" name="student_id" placeholder="e.g. 2026-0001" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <label>First Name:</label><br>
                <input type="text" name="first_name" placeholder="First Name" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <label>Last Name:</label><br>
                <input type="text" name="last_name" placeholder="Last Name" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <label>Course:</label><br>
                <input type="text" name="course" placeholder="e.g. BSIT" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <label>Year Level:</label><br>
                <input type="number" name="year_level" placeholder="e.g. 3" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <label>Email:</label><br>
                <input type="email" name="email" placeholder="student@example.com" required style="width: 100%; padding: 0.5rem; margin-top: 0.25rem;">
            </div>

            <div>
                <button type="submit" class="btn">Save Student</button>
            </div>
        </form>
    </div>

</body>

</html>