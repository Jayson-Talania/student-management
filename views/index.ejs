<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Management System</title>
    <link rel="stylesheet" href="/style.css" type="text/css">
</head>

<body>

    <header>
        <h1>Student Management System</h1>
        <nav>
            <a href="/students/add">Add Student</a>
        </nav>
    </header>

    <div class="container">

        <div class="action-bar">
            <h2>Student Directory</h2>
            
            <form action="/students/search" method="GET" class="search-form">
                <input type="text" name="keyword" placeholder="Search student...">
                <button type="submit">Search</button>
            </form>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Course</th>
                        <th>Year</th>
                        <th>Email</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (students.length > 0) { %>
                        <% students.forEach(student => { %>
                            <tr>
                                <td><%= student.id %></td>
                                <td><%= student.student_id %></td>
                                <td><%= student.first_name %> <%= student.last_name %></td>
                                <td><%= student.course %></td>
                                <td><%= student.year_level %></td>
                                <td><%= student.email %></td>
                                <td>
                                    <a href="/students/edit/<%= student.id %>" class="btn">Edit</a>
                                    <form action="/students/delete/<%= student.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                        <button type="submit" class="btn-delete">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center;">No students found.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

    </div>

</body>

</html>